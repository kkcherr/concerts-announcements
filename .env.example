# Copy this file to a new file named ".env" and fill in your real values.
# The .env file holds your secret keys and is never uploaded anywhere by this bot.

# Get this from @BotFather on Telegram (see README "Telegram bot token" section)
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# Get this by running: python main.py --get-chat-id  (see README "chat id" section)
TELEGRAM_CHAT_ID="your_numeric_chat_id"

# Get this from https://developer.ticketmaster.com/ (see README "Ticketmaster API key" section)
TICKETMASTER_API_KEY="your_ticketmaster_consumer_key"
